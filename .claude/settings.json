{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(node tools/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git branch*)",
      "Read(*)",
      "Edit(ui/**)",
      "Edit(gutenberg/**)",
      "Edit(unyson/**)",
      "Edit(specs/**)",
      "Edit(refs/**)",
      "Edit(docs/**)",
      "Write(ui/**)",
      "Write(gutenberg/**)",
      "Write(unyson/**)",
      "Write(specs/**)",
      "Write(refs/**)",
      "Write(docs/**)"
    ],
    "deny": [
      "Bash(git push --no-verify*)",
      "Bash(rm -rf*)",
      "Write(gutenberg/lib/asset-panda-ui/**)",
      "Edit(gutenberg/lib/asset-panda-ui/**)",
      "Write(unyson/lib/asset-panda-ui/**)",
      "Edit(unyson/lib/asset-panda-ui/**)"
    ]
  }
}
