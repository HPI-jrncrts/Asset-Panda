{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "assetpanda/continuity-columns",
	"title": "AP Continuity Columns",
	"category": "design",
	"icon": "columns",
	"description": "Three labelled columns over a timeline rule, with a closing line. Live: .apx-oc on /asset-intelligence-platform/. This block is an adapter — it holds no markup; it maps attributes to kit props.",
	"textdomain": "assetpanda",
	"attributes": {
		"eyebrow": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"title_accent": {
			"type": "string",
			"default": ""
		},
		"variant": {
			"type": "string",
			"default": "timeline",
			"enum": [
				"timeline",
				"numbered"
			]
		},
		"lede": {
			"type": "string",
			"default": ""
		},
		"items": {
			"type": "array",
			"default": []
		},
		"rule_svg": {
			"type": "string",
			"default": ""
		},
		"foot": {
			"type": "string",
			"default": ""
		},
		"align": {
			"type": "string",
			"default": "full"
		}
	},
	"supports": {
		"html": false,
		"reusable": true,
		"align": [
			"full",
			"wide"
		]
	},
	"render": "file:./render.php"
}
