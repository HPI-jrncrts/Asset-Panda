{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "assetpanda/feature-cards",
	"title": "AP Feature Cards",
	"category": "design",
	"icon": "screenoptions",
	"description": "Two-column section: heading block on the left, a two-column checklist of capabilities on the right. Figma: Home Page > Intelligence In Action (4331:24627). This block is an adapter — it holds no markup; it maps attributes to kit props.",
	"textdomain": "assetpanda",
	"attributes": {
		"eyebrow": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"title_accent": {
			"type": "string",
			"default": ""
		},
		"intro": {
			"type": "string",
			"default": ""
		},
		"items": {
			"type": "array",
			"default": []
		},
		"reveal": {
			"type": "boolean",
			"default": true
		},
		"align": {
			"type": "string",
			"default": "full"
		}
	},
	"supports": {
		"html": false,
		"reusable": true,
		"align": [
			"full",
			"wide"
		]
	},
	"render": "file:./render.php"
}
