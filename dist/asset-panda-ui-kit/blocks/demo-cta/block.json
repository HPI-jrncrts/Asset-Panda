{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "assetpanda/demo-cta",
	"title": "AP Demo Cta",
	"category": "design",
	"icon": "megaphone",
	"description": "Closing demo card: dark gradient panel with copy and a pull quote beside a demo form or button. Live: the `.ap-fire-footer-cta` card that closes every vertical page. This block is an adapter — it holds no markup; it maps attributes to kit props.",
	"textdomain": "assetpanda",
	"attributes": {
		"eyebrow": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"body": {
			"type": "string",
			"default": ""
		},
		"quote": {
			"type": "string",
			"default": ""
		},
		"quote_sub": {
			"type": "string",
			"default": ""
		},
		"form_heading": {
			"type": "string",
			"default": ""
		},
		"form_id": {
			"type": "string",
			"default": ""
		},
		"hubspot_portal": {
			"type": "string",
			"default": ""
		},
		"hubspot_form": {
			"type": "string",
			"default": ""
		},
		"hubspot_region": {
			"type": "string",
			"default": "na1"
		},
		"form_placeholders": {
			"type": "object",
			"default": {}
		},
		"form_submit": {
			"type": "string",
			"default": ""
		},
		"background": {
			"type": "string",
			"default": ""
		},
		"image": {
			"type": "string",
			"default": ""
		},
		"image_alt": {
			"type": "string",
			"default": ""
		},
		"cta_label": {
			"type": "string",
			"default": ""
		},
		"cta_url": {
			"type": "string",
			"default": ""
		},
		"reveal": {
			"type": "boolean",
			"default": true
		},
		"variant": {
			"type": "string",
			"default": "default",
			"enum": [
				"default",
				"platform",
				"hub",
				"eduhub"
			]
		},
		"image_width": {
			"type": "number",
			"default": 0
		},
		"image_height": {
			"type": "number",
			"default": 0
		},
		"anchor": {
			"type": "string",
			"default": ""
		},
		"bullets": {
			"type": "array",
			"default": []
		},
		"panel": {
			"type": "string",
			"default": "plain",
			"enum": [
				"plain",
				"card"
			]
		},
		"align": {
			"type": "string",
			"default": "full"
		}
	},
	"supports": {
		"html": false,
		"reusable": true,
		"align": [
			"full",
			"wide"
		]
	},
	"render": "file:./render.php"
}
