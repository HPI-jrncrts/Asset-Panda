{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "assetpanda/value-props",
	"title": "AP Value Props",
	"category": "design",
	"icon": "yes-alt",
	"description": "Heading with calls to action, colour-bordered benefit cards two to a row, and a closing line. Ported from the live homepage section #ap-built-field-v2 (Figma: Why Teams Choose Asset Panda, 4331:24830). This block is an adapter — it holds no markup; it maps attributes to kit props.",
	"textdomain": "assetpanda",
	"attributes": {
		"eyebrow": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"intro": {
			"type": "string",
			"default": ""
		},
		"primary_label": {
			"type": "string",
			"default": ""
		},
		"primary_url": {
			"type": "string",
			"default": ""
		},
		"secondary_label": {
			"type": "string",
			"default": ""
		},
		"secondary_url": {
			"type": "string",
			"default": ""
		},
		"items": {
			"type": "array",
			"default": []
		},
		"closing": {
			"type": "string",
			"default": ""
		},
		"reveal": {
			"type": "boolean",
			"default": true
		},
		"align": {
			"type": "string",
			"default": "full"
		}
	},
	"supports": {
		"html": false,
		"reusable": true,
		"align": [
			"full",
			"wide"
		]
	},
	"render": "file:./render.php"
}
