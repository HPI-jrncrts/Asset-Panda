{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "assetpanda/message-hero",
	"title": "AP Message Hero",
	"category": "design",
	"icon": "warning",
	"description": "Centred message page: an illustration, a big status code, the heading, a line of copy and a row of buttons and links, over the soft colour wash. Built for the branded 404 template (live /404-not-found/: 'Oops…Page Not Found!'). This block is an adapter — it holds no markup; it maps attributes to kit props.",
	"textdomain": "assetpanda",
	"attributes": {
		"image": {
			"type": "string",
			"default": ""
		},
		"image_alt": {
			"type": "string",
			"default": ""
		},
		"image_width": {
			"type": "number",
			"default": 0
		},
		"image_height": {
			"type": "number",
			"default": 0
		},
		"code": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"body": {
			"type": "string",
			"default": ""
		},
		"links": {
			"type": "array",
			"default": []
		},
		"background": {
			"type": "string",
			"default": ""
		},
		"align": {
			"type": "string",
			"default": "full"
		}
	},
	"supports": {
		"html": false,
		"reusable": true,
		"align": [
			"full",
			"wide"
		]
	},
	"render": "file:./render.php"
}
