{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "assetpanda/faq",
	"title": "AP Faq",
	"category": "design",
	"icon": "editor-help",
	"description": "FAQ accordion: a centred heading over ruled question rows that open in place. Live: the `.ap-faq` section on every vertical, hub and solution page. This block is an adapter — it holds no markup; it maps attributes to kit props.",
	"textdomain": "assetpanda",
	"attributes": {
		"eyebrow": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"items": {
			"type": "array",
			"default": []
		},
		"open_first": {
			"type": "boolean",
			"default": true
		},
		"schema": {
			"type": "boolean",
			"default": false
		},
		"reveal": {
			"type": "boolean",
			"default": true
		},
		"align": {
			"type": "string",
			"default": "full"
		}
	},
	"supports": {
		"html": false,
		"reusable": true,
		"align": [
			"full",
			"wide"
		]
	},
	"render": "file:./render.php"
}
