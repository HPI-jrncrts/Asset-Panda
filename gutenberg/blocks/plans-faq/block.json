{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "assetpanda/plans-faq",
	"title": "AP Plans Faq",
	"category": "design",
	"icon": "editor-help",
	"description": "Pricing v2 FAQ: centred heading over bordered question cards that open in place (plus turns to minus). Source: the Asset Panda Pricing v2 mockup. This block is an adapter — it holds no markup; it maps attributes to kit props.",
	"textdomain": "assetpanda",
	"attributes": {
		"variant": {
			"type": "string",
			"default": "classic",
			"enum": [
				"classic",
				"clean"
			]
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"items": {
			"type": "array",
			"default": []
		},
		"open_first": {
			"type": "boolean",
			"default": true
		},
		"schema": {
			"type": "boolean",
			"default": false
		},
		"align": {
			"type": "string",
			"default": "full"
		}
	},
	"supports": {
		"html": false,
		"reusable": true,
		"align": [
			"full",
			"wide"
		]
	},
	"render": "file:./render.php"
}
