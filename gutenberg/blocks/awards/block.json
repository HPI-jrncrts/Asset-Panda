{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "assetpanda/awards",
	"title": "AP Awards",
	"category": "design",
	"icon": "awards",
	"description": "A row of award, rating and compliance badges. Logos only, no copy. Sits between major sections as a trust strip. This block is an adapter — it holds no markup; it maps attributes to kit props.",
	"textdomain": "assetpanda",
	"attributes": {
		"items": {
			"type": "array",
			"default": []
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"theme": {
			"type": "string",
			"default": "light",
			"enum": [
				"light",
				"alt"
			]
		},
		"layout": {
			"type": "string",
			"default": "wrap",
			"enum": [
				"wrap",
				"row",
				"spread",
				"hub",
				"eduhub"
			]
		},
		"reveal": {
			"type": "boolean",
			"default": true
		},
		"align": {
			"type": "string",
			"default": "full"
		}
	},
	"supports": {
		"html": false,
		"reusable": true,
		"align": [
			"full",
			"wide"
		]
	},
	"render": "file:./render.php"
}
