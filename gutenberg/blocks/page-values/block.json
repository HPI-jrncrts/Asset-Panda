{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "assetpanda/page-values",
	"title": "AP Page Values",
	"category": "design",
	"icon": "block-default",
	"description": "People-and-values section of the 2026 company pages (Our Company, Figma 7455:103802): a header row (eyebrow, heading with a gradient phrase, lede; an arrow link on the right), then a list of icon points (40px icon, bold line, short text) beside a rounded photo. This block is an adapter — it holds no markup; it maps attributes to kit props.",
	"textdomain": "assetpanda",
	"attributes": {
		"anchor": {
			"type": "string",
			"default": ""
		},
		"eyebrow": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"title_accent": {
			"type": "string",
			"default": ""
		},
		"lede": {
			"type": "string",
			"default": ""
		},
		"link_label": {
			"type": "string",
			"default": ""
		},
		"link_url": {
			"type": "string",
			"default": ""
		},
		"items": {
			"type": "array",
			"default": []
		},
		"image": {
			"type": "string",
			"default": ""
		},
		"image_alt": {
			"type": "string",
			"default": ""
		},
		"image_width": {
			"type": "number",
			"default": 0
		},
		"image_height": {
			"type": "number",
			"default": 0
		},
		"align": {
			"type": "string",
			"default": "full"
		}
	},
	"supports": {
		"html": false,
		"reusable": true,
		"align": [
			"full",
			"wide"
		]
	},
	"render": "file:./render.php"
}
