{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "assetpanda/page-founder",
	"title": "AP Page Founder",
	"category": "design",
	"icon": "block-default",
	"description": "Founder section of the 2026 company pages (Our Company, Figma 7460:104311): a square photo with rounded corners beside an eyebrow, the heading (h2) with a small green second line inside it (e.g. the title), paragraphs and an icon link, on an indigo-50-to-white band with a soft green orb. This block is an adapter — it holds no markup; it maps attributes to kit props.",
	"textdomain": "assetpanda",
	"attributes": {
		"anchor": {
			"type": "string",
			"default": ""
		},
		"eyebrow": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"subtitle": {
			"type": "string",
			"default": ""
		},
		"body": {
			"type": "string",
			"default": ""
		},
		"link_label": {
			"type": "string",
			"default": ""
		},
		"link_url": {
			"type": "string",
			"default": ""
		},
		"link_icon": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"linkedin"
			]
		},
		"image": {
			"type": "string",
			"default": ""
		},
		"image_alt": {
			"type": "string",
			"default": ""
		},
		"image_width": {
			"type": "number",
			"default": 0
		},
		"image_height": {
			"type": "number",
			"default": 0
		},
		"align": {
			"type": "string",
			"default": "full"
		}
	},
	"supports": {
		"html": false,
		"reusable": true,
		"align": [
			"full",
			"wide"
		]
	},
	"render": "file:./render.php"
}
