{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "assetpanda/link-cards",
	"title": "AP Link Cards",
	"category": "design",
	"icon": "grid-view",
	"description": "Picker grid: two-up image cards, each with an icon, title, description and an explore link, under a centred heading. Live: #ap-gov-picker on the industry hubs. This block is an adapter — it holds no markup; it maps attributes to kit props.",
	"textdomain": "assetpanda",
	"attributes": {
		"eyebrow": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"title_accent": {
			"type": "string",
			"default": ""
		},
		"head_width": {
			"type": "number",
			"default": 0
		},
		"items": {
			"type": "array",
			"default": []
		},
		"stack": {
			"type": "string",
			"default": "1024",
			"enum": [
				"1024",
				"900"
			]
		},
		"variant": {
			"type": "string",
			"default": "default",
			"enum": [
				"default",
				"eduhub",
				"hub26"
			]
		},
		"align": {
			"type": "string",
			"default": "full"
		}
	},
	"supports": {
		"html": false,
		"reusable": true,
		"align": [
			"full",
			"wide"
		]
	},
	"render": "file:./render.php"
}
