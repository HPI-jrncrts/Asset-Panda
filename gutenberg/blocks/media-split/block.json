{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "assetpanda/media-split",
	"title": "AP Media Split",
	"category": "design",
	"icon": "align-pull-left",
	"description": "Split row: copy with explore links beside a composed scene of floating images and soft glows (the Ursa and integrations scenes). Live: the rows inside #ap-gov-intel on the industry hubs. This block is an adapter — it holds no markup; it maps attributes to kit props.",
	"textdomain": "assetpanda",
	"attributes": {
		"eyebrow": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"title_accent": {
			"type": "string",
			"default": ""
		},
		"body": {
			"type": "string",
			"default": ""
		},
		"links": {
			"type": "array",
			"default": []
		},
		"reverse": {
			"type": "boolean",
			"default": false
		},
		"images": {
			"type": "array",
			"default": []
		},
		"glows": {
			"type": "array",
			"default": []
		},
		"align": {
			"type": "string",
			"default": "full"
		}
	},
	"supports": {
		"html": false,
		"reusable": true,
		"align": [
			"full",
			"wide"
		]
	},
	"render": "file:./render.php"
}
